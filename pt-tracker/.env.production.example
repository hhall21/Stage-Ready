APP_NAME="Stage-Ready"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://stage-ready.co.uk

# Publish real policies and use a monitored support inbox before launch.
SUPPORT_EMAIL=support@stage-ready.co.uk
PRIVACY_POLICY_URL=https://stage-ready.co.uk/privacy
TERMS_OF_SERVICE_URL=https://stage-ready.co.uk/terms
# Leave empty for Nginx directly serving HTTPS. Never use *.
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stage_ready
DB_USERNAME=stage_ready
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
SESSION_COOKIE=stage_ready_production_session
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# Keep storage persistent and outside public/. These defaults use storage/app/private.
# CHECKIN_PHOTOS_ROOT=/var/lib/stage-ready/check-in-photos
# TEMPORARY_CHECKIN_PHOTOS_ROOT=/var/lib/stage-ready/temporary-check-in-photos

# Example: Resend SMTP. Replace sender and password; verify the sending domain.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="accounts@stage-ready.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_SECRET_KEY=
STRIPE_POWERLIFTING_PRICE_ID=
STRIPE_BODYBUILDING_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=true

VITE_APP_NAME="${APP_NAME}"
