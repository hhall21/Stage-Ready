APP_NAME="Stage-Ready"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.stage-ready.co.uk
SUPPORT_EMAIL=support@stage-ready.co.uk
PRIVACY_POLICY_URL=https://staging.stage-ready.co.uk/privacy
TERMS_OF_SERVICE_URL=https://staging.stage-ready.co.uk/terms
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stage_ready_staging
DB_USERNAME=stage_ready_staging
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
SESSION_COOKIE=stage_ready_staging_session
SESSION_DOMAIN=null

# Optional writable private directory, outside the public web root.
# CHECKIN_PHOTOS_ROOT=/absolute/private/path/check-in-photos
# TEMPORARY_CHECKIN_PHOTOS_ROOT=/absolute/private/path/temporary-check-in-photos

# Use a configured SMTP or supported provider for invitation and reset emails.
# The log mailer records messages locally and does not deliver to inboxes.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="accounts@stage-ready.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Use matching test credentials, both Prices and webhook signing secret in staging.
STRIPE_SECRET_KEY=
STRIPE_POWERLIFTING_PRICE_ID=
STRIPE_BODYBUILDING_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
