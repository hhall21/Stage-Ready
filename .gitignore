# Local environment, credentials, and client databases.
.env
.env.*
!.env.example
!.env.staging.example
/*.txt
/pt-tracker/database/*.sqlite
/pt-tracker/database/*.sqlite-*
/pt-tracker/database/*.db
!/pt-tracker/database/demo.sqlite
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/auth.json
/pt-tracker/database/*.sql
/pt-tracker/database/*.sql.gz
/pt-tracker/public-readiness*.json

# Runtime data stays local; retain Laravel's directory placeholder files.
/pt-tracker/storage/**
!/pt-tracker/storage/**/
!/pt-tracker/storage/**/.gitignore

# Installed dependencies, build output, and generated routes are also ignored
# by pt-tracker/.gitignore.
